# Required to hit the real ChatGPT API. Without this set, the app runs in
# mock mode: it simulates variation generation and responses locally so you
# can exercise the whole flow (and the dashboard) without spending money.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini for both generating prompt variations
# and answering them.
OPENAI_MODEL=gpt-4o-mini
